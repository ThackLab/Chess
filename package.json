{
  "name": "grandmasters",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "description": "Play Stockfish-powered bots from 250 to 3200 Elo, get in-depth game reviews, and analyse PGNs. Runs fully in your browser.",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "prepare-assets": "node scripts/prepare.mjs",
    "predev": "node scripts/prepare.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "pretest": "node scripts/prepare.mjs",
    "test": "vitest run",
    "openings": "node scripts/build-openings.mjs",
    "format": "prettier --write src scripts *.ts *.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@dicebear/adventurer": "9.2.4",
    "@dicebear/avataaars": "9.2.4",
    "@dicebear/big-ears": "9.2.4",
    "@dicebear/big-smile": "9.2.4",
    "@dicebear/bottts": "9.2.4",
    "@dicebear/core": "9.2.4",
    "@dicebear/croodles": "9.2.4",
    "@dicebear/dylan": "9.2.4",
    "@dicebear/fun-emoji": "9.2.4",
    "@dicebear/lorelei": "9.2.4",
    "@dicebear/micah": "9.2.4",
    "@dicebear/miniavs": "9.2.4",
    "@dicebear/notionists": "9.2.4",
    "@dicebear/open-peeps": "9.2.4",
    "@dicebear/personas": "9.2.4",
    "@dicebear/pixel-art": "9.2.4",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stockfish": "^18.0.8",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
